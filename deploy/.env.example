# Copy to .env (same folder as docker-compose.yml) on the server and fill in.
# Never commit the real .env.

# The server's public address, WITHOUT https://
# e.g. pilliongo.centralindia.cloudapp.azure.com
DOMAIN=your-name.centralindia.cloudapp.azure.com

# Database (TiDB Cloud)
DB_URL=jdbc:mysql://YOUR-HOST:4000/pilliongo?sslMode=VERIFY_IDENTITY
DB_USERNAME=YOUR-USERNAME.root
DB_PASSWORD=your_database_password
DB_POOL_SIZE=5

# Long random string, e.g. from:  openssl rand -base64 48
JWT_SECRET=change_me

# Brevo SMTP key
MAIL_PASSWORD=your_brevo_smtp_key

# Your frontend's address(es), comma-separated
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
