# Copy this file to .env (same folder as pom.xml) and fill in real values.
# .env is git-ignored and loaded automatically at startup via
# spring.config.import in application.properties. Real OS environment
# variables with the same names override it.

# MySQL password (spring.datasource.password)
DB_PASSWORD=your_mysql_password

# Secret used to sign JWTs — use a long random string (32+ chars), e.g.
#   openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Brevo SMTP key for sending OTP emails (not your Brevo login password):
#   Brevo dashboard -> SMTP & API -> SMTP tab -> Generate a new SMTP key
MAIL_PASSWORD=your_brevo_smtp_key

# ---- Only needed when deploying (your laptop uses the defaults) ----
# Database address and user. Example for TiDB Cloud (MySQL-compatible):
#   DB_URL=jdbc:mysql://<host>:4000/pilliongo?sslMode=VERIFY_IDENTITY
# DB_URL=jdbc:mysql://localhost:3306/pilliongo
# DB_USERNAME=root
# DB_POOL_SIZE=10

# Website addresses allowed to call this API, comma-separated.
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Print every SQL query (debugging only).
# SHOW_SQL=false
