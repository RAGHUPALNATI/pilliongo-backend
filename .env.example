# Copy this file to .env (same folder as pom.xml) and fill in real values.
# .env is git-ignored and loaded automatically at startup via
# spring.config.import in application.properties. Real OS environment
# variables with the same names override it.

# MySQL password (spring.datasource.password)
DB_PASSWORD=your_mysql_password

# Secret used to sign JWTs — use a long random string (32+ chars), e.g.
#   openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Gmail *app password* for sending OTP emails (not your normal password):
#   Google Account -> Security -> 2-Step Verification -> App passwords
MAIL_PASSWORD=your_gmail_app_password
